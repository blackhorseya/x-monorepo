        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 35,
      "title": "Reservations by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "inventory_reservations{status}: RESERVED is stock on hold for an order that has not moved on, REJECTED a shortfall (ordering was asked to cancel), RELEASED a cancelled order's hold given back, CANCELLED a tombstone (OrderCancelled overtook OrderCreated).",
      "gridPos": {
        "x": 8,
        "y": 41,
        "w": 8,
        "h": 8
      },
      "targets": [
