    {
      "id": 39,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "hit / (hit + miss). Cached refusals count as hits. Near 1 in steady state (one DB lookup per key per 30s TTL); a drop means many distinct keys (guessing) or a cache reset at 10k entries.",
      "gridPos": {
        "x": 6,
        "y": 88,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(identity_resolver_lookups_total{job=\"$service\",result=\"hit\"}[$__rate_interval])) / (sum(rate(identity_resolver_lookups_total{job=\"$service\",result=\"hit\"}[$__rate_interval])) + sum(rate(identity_resolver_lookups_total{job=\"$service\",result=\"miss\"}[$__rate_interval])))",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 40,
      "title": "Resolver errors: / s and share of DB lookups",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "error is a database failure or timeout while resolving a key (the request is rejected as auth.invalid_credential; keys verified within the TTL are still served from cache). Healthy = 0. The share is error / (db_ok + db_miss + error): the alert x-monorepo-identity-resolver-errors fires above 5% for 5m.",
      "gridPos": {
        "x": 12,
        "y": 88,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(identity_resolver_lookups_total{job=\"$service\",result=\"error\"}[$__rate_interval]))",
          "legendFormat": "errors / s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(identity_resolver_lookups_total{job=\"$service\",result=\"error\"}[$__rate_interval])) / sum(rate(identity_resolver_lookups_total{job=\"$service\",result=~\"db_ok|db_miss|error\"}[$__rate_interval]))",
          "legendFormat": "error share of DB lookups"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error share of DB lookups"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
