{
  "uid": "x-monorepo-rpc",
  "title": "x-monorepo / service",
  "tags": [
    "x-monorepo",
    "otel"
  ],
  "description": "RED view of one deployable (job = service.name): Connect RPCs, use cases, plain HTTP routes, Go runtime, WARN/ERROR logs. Source: deployments/docker/grafana/dashboards/rpc.json.",
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(usecase_duration_seconds_count, job)",
          "refId": "service"
        },
        "definition": "label_values(usecase_duration_seconds_count, job)",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "rpc",
          "value": "rpc"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
