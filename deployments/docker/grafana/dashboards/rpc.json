    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(usecase_duration_seconds_count, job)",
          "refId": "service"
        },
        "definition": "label_values(usecase_duration_seconds_count, job)",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "rpc",
          "value": "rpc"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
