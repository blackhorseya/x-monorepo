        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (topic, consumer_group, broker)(eventbus_consumer_lag{job=\"$service\"})",
          "legendFormat": "{{consumer_group}} \u2190 {{topic}} ({{broker}})"
        }
