#!/bin/sh
# helm for the scripts the kind tasks run (deployments/helm/kind/*.sh): whatever the script does with KUBECONFIG,
# every helm it starts, from any depth (xargs, bash -c, timeout, a background job), reaches the real helm with
# --kubeconfig $KIND_KUBECONFIG (the file `kind get kubeconfig` wrote for the task's cluster). No KIND_KUBECONFIG: no call.
# The Taskfile's own helm commands do not go through here; each carries the flag itself. See check-kubeconfig.py.
d=$(cd "$(dirname "$0")" && pwd) || exit 1
[ -n "${KIND_KUBECONFIG:-}" ] || { echo "helm: KIND_KUBECONFIG is not set (run it through a kind task)" >&2; exit 1; }
p="" ; old_ifs=$IFS ; IFS=:
for e in $PATH; do [ "$e" = "$d" ] || p="${p:+$p:}$e"; done
IFS=$old_ifs
real=$(PATH="$p" command -v helm) || { echo "helm: not found on PATH" >&2; exit 127; }
exec "$real" --kubeconfig "$KIND_KUBECONFIG" "$@"
