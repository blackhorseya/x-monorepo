// Package memory holds the in-memory implementations used when no database is configured
// (APP_POSTGRES_URL unset) and by tests.
package memory

import (
	"context"
	"sync"

	"<% .Module %>/pkgs/platform/contextx"
	"<% .Module %>/pkgs/<% .Name %>/domain/<% .Name %>"
)

var _ <% .Name %>.Repository = (*<% .Title %>Repository)(nil)

// <% .Title %>Repository keeps each <% .Title %> as its persisted state, like a row.
type <% .Title %>Repository struct {
	mu   sync.RWMutex
	data map[<% .Name %>.ID]<% .Name %>.ReconstituteParams
}

func New<% .Title %>Repository() *<% .Title %>Repository {
	return &<% .Title %>Repository{data: map[<% .Name %>.ID]<% .Name %>.ReconstituteParams{}}
}

func (i *<% .Title %>Repository) FindByID(c context.Context, id <% .Name %>.ID) (*<% .Name %>.<% .Title %>, error) {
	if err := contextx.FromContext(c).Err(); err != nil {
		return nil, err
	}

	i.mu.RLock()
	defer i.mu.RUnlock()

	p, ok := i.data[id]
	if !ok {
		return nil, <% .Name %>.ErrNotFound
	}

	return <% .Name %>.Reconstitute(p)
}

func (i *<% .Title %>Repository) Save(c context.Context, x *<% .Name %>.<% .Title %>) error {
	if err := contextx.FromContext(c).Err(); err != nil {
		return err
	}

	i.mu.Lock()
	defer i.mu.Unlock()

	if _, exists := i.data[x.ID()]; exists {
		return <% .Name %>.ErrAlreadyExists
	}
	i.data[x.ID()] = <% .Name %>.ReconstituteParams{ID: x.ID(), Name: x.Name(), CreatedAt: x.CreatedAt()}

	return nil
}
