package postgres

import (
	"context"

	"gorm.io/gorm"

	platformpg "<% .Module %>/pkgs/platform/postgres"
	"<% .Module %>/pkgs/<% .Name %>/application/port"
)

var _ port.Transactor = (*Transactor)(nil)

// Transactor opens one gorm transaction for fn and carries it in the context, where the
// repositories<% if .Events %> and the eventbus publisher<% end %> pick it up.
type Transactor struct {
	db *gorm.DB
}

func NewTransactor(db *gorm.DB) *Transactor { return &Transactor{db: db} }

func (i *Transactor) Do(c context.Context, fn func(c context.Context) error) error {
	return platformpg.Transaction(c, i.db, func(c context.Context, _ *gorm.DB) error { return fn(c) })
}
