package <% .Name %>_test

import (
	"errors"
	"strings"
	"testing"
	"time"

	"<% .Module %>/pkgs/<% .Name %>/domain/<% .Name %>"
)

func TestNew(t *testing.T) {
	now := time.Date(2026, 11, 9, 8, 0, 0, 0, time.UTC)

	for _, tc := range []struct {
		name string
		id   <% .Name %>.ID
		in   string
		want error
	}{
		{"ok", "id-1", "a name", nil},
		{"no id", "", "a name", <% .Name %>.ErrInvalidID},
		{"empty name", "id-1", "", <% .Name %>.ErrInvalidName},
		{"name too long", "id-1", strings.Repeat("x", 201), <% .Name %>.ErrInvalidName},
	} {
		t.Run(tc.name, func(t *testing.T) {
			x, err := <% .Name %>.New(tc.id, tc.in, now)
			if !errors.Is(err, tc.want) {
				t.Fatalf("New() error = %v, want %v", err, tc.want)
			}
			if err == nil && (x.ID() != tc.id || x.Name() != tc.in || !x.CreatedAt().Equal(now)) {
				t.Fatalf("New() = %v %q %v, want the inputs back", x.ID(), x.Name(), x.CreatedAt())
			}
		})
	}
}<% if .Events %>

func TestNewRaisesCreatedOnce(t *testing.T) {
	x, err := <% .Name %>.New("id-1", "a name", time.Date(2026, 11, 9, 8, 0, 0, 0, time.UTC))
	if err != nil {
		t.Fatal(err)
	}
	evs := x.PullEvents()
	if len(evs) != 1 || evs[0].AggregateID() != "id-1" {
		t.Fatalf("PullEvents() = %v, want one Created for id-1", evs)
	}
	if again := x.PullEvents(); len(again) != 0 {
		t.Fatalf("PullEvents() again = %v, want none", again)
	}
}<% end %>
