// Package port declares what the <% .Name %> use cases need from the outside world.
// Implementations live in <% .Name %>/infra<% if .Events %> and <% .Name %>/adapters<% end %>.
package port

import (
	"context"
	"time"
<% if .Events %>
	"<% .Module %>/pkgs/<% .Name %>/domain/<% .Name %>"<% end %>
)

// Clock abstracts time for deterministic tests.
type Clock interface {
	Now() time.Time
}

// IDGenerator mints ids.
type IDGenerator interface {
	NewID(c context.Context) (string, error)
}

// Transactor runs fn atomically: every repository call<% if .Events %> and every event published<% end %> inside fn commits together
// or not at all. Use cases do not call it: provider.go wraps every writing use case with
// usecasex.Transactional(tx). The memory implementation just calls fn.
type Transactor interface {
	Do(c context.Context, fn func(c context.Context) error) error
}<% if .Events %>

// Inbox records consumed event message ids (usecasex.Inbox, this BC's own type so wire tells BCs
// apart). Use cases do not call it: provider.go wraps every writing use case with
// usecasex.Idempotent(inbox), inside the transaction, and a redelivered message is dropped before
// the use case runs.
type Inbox interface {
	Record(c context.Context, id string) (first bool, err error)
}

// EventPublisher hands domain events to the outside world. Called inside Transactor.Do so the
// events share the state change's transaction (the transactional outbox).
type EventPublisher interface {
	Publish(c context.Context, events ...<% .Name %>.Event) error
}<% end %>
