// Package rpc adapts the generated <% .Name %>.v1 contract to use cases.
package rpc

import (
	"context"

	"connectrpc.com/connect/v2"
	"google.golang.org/protobuf/types/known/timestamppb"

	"<% .Module %>/pkgs/platform/server"
	"<% .Module %>/pkgs/platform/usecasex"
	"<% .Module %>/pkgs/<% .Name %>/application/dto"
	<% .Name %>v1 "<% .Module %>/pkgs/<% .Name %>/contract/v1"
	"<% .Module %>/pkgs/<% .Name %>/contract/v1/<% .Name %>v1connect"
)

var _ <% .Name %>v1connect.<% .Title %>ServiceHandler = (*<% .Title %>Service)(nil)

// Use-case aliases keep handler signatures readable.
type (
	Create<% .Title %>UC = usecasex.UseCase[dto.Create<% .Title %>Input, *dto.<% .Title %>Output]
	Get<% .Title %>UC    = usecasex.UseCase[dto.Get<% .Title %>Input, *dto.<% .Title %>Output]
)

// <% .Title %>Service implements the generated <% .Title %>ServiceHandler. Who may call each method is declared in
// the proto and enforced by the server's interceptors, so no handler checks it.
type <% .Title %>Service struct {
	create Create<% .Title %>UC
	get    Get<% .Title %>UC
}

func New<% .Title %>Service(create Create<% .Title %>UC, get Get<% .Title %>UC) *<% .Title %>Service {
	return &<% .Title %>Service{create: create, get: get}
}

// Register serves the service on s (Connect + gRPC + gRPC-Web on one port).
func (h *<% .Title %>Service) Register(s *connect.Server) {
	<% .Name %>v1connect.Register<% .Title %>ServiceHandler(s, h)
}

// Create<% .Title %> adds a <% .Title %>.
func (h *<% .Title %>Service) Create<% .Title %>(
	c context.Context,
	req *<% .Name %>v1.Create<% .Title %>Request,
) (*<% .Name %>v1.Create<% .Title %>Response, error) {
	out, err := h.create.Execute(c, dto.Create<% .Title %>Input{Name: req.GetName()})
	if err != nil {
		return nil, server.ToConnectError(err)
	}

	return &<% .Name %>v1.Create<% .Title %>Response{<% .Title %>: toProto(out)}, nil
}

func (h *<% .Title %>Service) Get<% .Title %>(
	c context.Context,
	req *<% .Name %>v1.Get<% .Title %>Request,
) (*<% .Name %>v1.Get<% .Title %>Response, error) {
	out, err := h.get.Execute(c, dto.Get<% .Title %>Input{ID: req.GetId()})
	if err != nil {
		return nil, server.ToConnectError(err)
	}

	return &<% .Name %>v1.Get<% .Title %>Response{<% .Title %>: toProto(out)}, nil
}

func toProto(x *dto.<% .Title %>Output) *<% .Name %>v1.<% .Title %> {
	return &<% .Name %>v1.<% .Title %>{Id: x.ID, Name: x.Name, CreateTime: timestamppb.New(x.CreateTime)}
}
