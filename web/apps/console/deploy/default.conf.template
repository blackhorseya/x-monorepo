# Rendered by the nginx image entrypoint (envsubst, RPC_UPSTREAM only) into
# /tmp/default.conf. One server: the Vite build at /, the rpc at /api.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Probes. Does not consult the rpc: a console pod is ready when nginx is.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Connect RPCs, /api/docs, /api/version … Same prefix as client.ts uses, so the browser
    # stays same-origin and the rpc needs no CORS. HTTP/1.1 (Connect over JSON / gRPC-Web);
    # native gRPC clients talk to the rpc Service directly, not through here.
    location /api/ {
        proxy_pass ${RPC_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    # Hashed assets: cache forever. index.html: never, so a deploy is picked up on reload.
    # Both carry the security headers (CSP etc., deploy/security-headers.conf).
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
