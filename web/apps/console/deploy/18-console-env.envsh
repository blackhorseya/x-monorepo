#!/bin/sh
# Sourced by the nginx image entrypoint before the templates are rendered (docker-entrypoint.d/*.envsh).
# Turns the operator's CONSOLE_* environment into the values the templates may use, and refuses
# anything that could break out of them: the issuer ends up in /config.json and in the CSP, so it
# has to look like a plain http(s) origin plus path, the client id like a plain identifier.
# Anything unusable stops the container (a misconfigured login must be noticed, not silently off);
# nothing from a rejected value is ever rendered.
#
#   CONSOLE_OIDC_ISSUER      e.g. https://idp.example.com/dex   (empty = OIDC off)
#   CONSOLE_OIDC_CLIENT_ID   the public client id               (empty = OIDC off)
#   CONSOLE_API_KEY_LOGIN    "false" removes the API key entry; anything else keeps it
# Derived: CONSOLE_CSP_CONNECT_SRC = 'self' [+ the issuer's exact origin].
# None of it is a secret: /config.json is public.

console_issuer=${CONSOLE_OIDC_ISSUER:-}
console_client=${CONSOLE_OIDC_CLIENT_ID:-}

console_refuse() {
  echo "console-env: $1; refusing to start" >&2
  exit 1
}

# Both or neither: an issuer without a client id (or the reverse) is half a login.
if [ -n "$console_issuer$console_client" ]; then
  [ -n "$console_issuer" ] && [ -n "$console_client" ] || console_refuse "CONSOLE_OIDC_ISSUER and CONSOLE_OIDC_CLIENT_ID must be set together"
  # No control character at all (a newline would slip past a line-oriented grep and split the
  # rendered JSON / CSP header); checked with a shell pattern, which sees the whole value.
  case "$console_issuer$console_client" in
    *[![:print:]]*) console_refuse "CONSOLE_OIDC_ISSUER / CONSOLE_OIDC_CLIENT_ID contain a control character" ;;
  esac
  case "$console_issuer" in
    http://* | https://*) ;;
    *) console_refuse "CONSOLE_OIDC_ISSUER must be an http(s) URL" ;;
  esac
  # One origin plus an optional path: no userinfo, query, fragment, quotes or spaces.
  printf '%s' "$console_issuer" | grep -Eq '^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$' || console_refuse "CONSOLE_OIDC_ISSUER is not a plain origin plus path"
  # The browser parses this same string with new URL(): whatever it would reject must be rejected
  # here too, or the container starts and the SPA silently turns OIDC off. So the host must be
  # dot-separated DNS labels (or a canonical IPv4: four octets 0-255, no leading zeros, since a numeric
  # last label makes the URL parser read it as IPv4), and a port must be 1-65535.
  console_hostport=${console_issuer#*://}
  console_hostport=${console_hostport%%/*}
  console_host=${console_hostport%%:*}
  printf '%s' "$console_host" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$' || console_refuse "CONSOLE_OIDC_ISSUER has an invalid host"
  case "$console_hostport" in
    *:*)
      console_port=${console_hostport#*:}
      [ "$console_port" -ge 1 ] 2>/dev/null && [ "$console_port" -le 65535 ] || console_refuse "CONSOLE_OIDC_ISSUER has an invalid port (1-65535)"
      ;;
  esac
  case "${console_host##*.}" in
    # 0x.. is a hexadecimal IPv4 part to the URL parser (WHATWG): it rejects such a host unless it is a
    # complete IPv4 address, and the dotted-decimal form is the only one this gate allows.
    0[xX]*) console_refuse "CONSOLE_OIDC_ISSUER has a numeric (hex) last host label" ;;
    *[!0-9]*) ;;
    *)
      printf '%s' "$console_host" | grep -Eq '^(0|[1-9][0-9]{0,2})(\.(0|[1-9][0-9]{0,2})){3}$' || console_refuse "CONSOLE_OIDC_ISSUER has an invalid IPv4 host"
      for console_octet in $(printf '%s' "$console_host" | tr . ' '); do
        [ "$console_octet" -le 255 ] || console_refuse "CONSOLE_OIDC_ISSUER has an invalid IPv4 host"
      done
      ;;
  esac
  printf '%s' "$console_client" | grep -Eq '^[A-Za-z0-9._~-]+$' || console_refuse "CONSOLE_OIDC_CLIENT_ID is not a plain identifier"
  CONSOLE_CSP_CONNECT_SRC="'self' $(printf '%s' "$console_issuer" | sed -E 's#^(https?://[^/]+).*#\1#')"
else
  CONSOLE_CSP_CONNECT_SRC="'self'"
fi
CONSOLE_OIDC_ISSUER=$console_issuer
CONSOLE_OIDC_CLIENT_ID=$console_client
if [ "${CONSOLE_API_KEY_LOGIN:-true}" = false ]; then CONSOLE_API_KEY_LOGIN=false; else CONSOLE_API_KEY_LOGIN=true; fi
export CONSOLE_OIDC_ISSUER CONSOLE_OIDC_CLIENT_ID CONSOLE_API_KEY_LOGIN CONSOLE_CSP_CONNECT_SRC
unset console_issuer console_client console_hostport console_host console_port console_octet
